{
  "name": "react-unify",
  "version": "0.1.0",
  "description": "Find structurally similar React components and write a clickable cluster report. Optional LLM proposer drafts the unified component.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "react-unify": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Muronuch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muronuch/react-unify.git"
  },
  "homepage": "https://github.com/Muronuch/react-unify#readme",
  "bugs": {
    "url": "https://github.com/Muronuch/react-unify/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "refactoring",
    "duplicate-detection",
    "code-analysis",
    "claude-code",
    "ast",
    "ts-morph",
    "component",
    "deduplication"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    ".claude/skills"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "ora": "^8.2.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
